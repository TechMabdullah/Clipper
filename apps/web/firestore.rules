rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : 'customer';
    }

    function isStaff() {
      return role() in ['support', 'admin', 'superadmin'];
    }

    function isAdmin() {
      return role() in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return role() == 'superadmin';
    }

    // Users: read own document; staff can read directory; role/disabled escalation forbidden from client SDK
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disabled', 'revokedAllBefore', 'plan']);
      allow create, delete: if false; // Managed exclusively by Firebase Admin SDK on the Next.js server
    }

    // Orders & invoices: read own orders or staff
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow write: if false; // Mutated via server Admin SDK / Stripe webhook handlers
    }

    // Support tickets: owner or support+
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isStaff() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // Notifications: user or wildcard announcements
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.uid == '*' || isAdmin());
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, delete: if false;
    }

    // Public read-only collections for active announcements, FAQs, and maintenance flags
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faq_items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if docId == 'maintenance' || isAdmin();
      allow write: if isAdmin();
    }

    match /feature_flags/{key} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Sensitive server-only collections locked to Admin SDK (client access denied 100%)
    match /email_otps/{docId} {
      allow read, write: if false;
    }

    match /admin_totp/{uid} {
      allow read, write: if false;
    }

    match /user_sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Immutable append-only audit logs (Admin SDK writes; support/admin can inspect only)
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }
  }
}
