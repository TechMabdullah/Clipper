{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/jest.config.*"
    ],
    "sharedGlobals": ["{workspaceRoot}/nx.json"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "lint": { "cache": true },
    "typecheck": { "cache": true },
    "test": { "cache": true }
  },
  "plugins": [
    { "plugin": "@nx/next/plugin", "options": { "serveTargetName": "serve" } },
    { "plugin": "@nx/node/plugin", "options": { "serveTargetName": "serve" } }
  ]
}
