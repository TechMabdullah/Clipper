{
  "name": "clipper-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "clipper": "tsx --env-file=.env.local apps/clipper-service/src/index.ts",
    "notify": "tsx --env-file=.env.local apps/notification-service/src/index.ts",
    "live": "tsx --env-file=.env.local apps/clipper-service/src/live/cli.ts",
    "tui": "python clipper_tui.py",
    "dev": "concurrently \"pnpm clipper\" \"pnpm notify\"",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "node --import tsx --test apps/clipper-service/src/app.test.ts"
  },
  "devDependencies": {
    "@nx/eslint": "^20.0.0",
    "@nx/js": "^20.0.0",
    "@nx/node": "20.0.0",
    "concurrently": "^9.0.0",
    "nx": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
