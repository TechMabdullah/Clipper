# ==========================================
# CLIPPER STUDIO — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and paste your credentials.
# ==========================================

# ── Server & Ports ────────────────────────
CLIPPER_PORT=4001
NOTIFICATION_PORT=4003
HOST="127.0.0.1"
NOTIFICATION_SERVICE_URL="http://localhost:4003"
CLIPPER_SERVICE_URL="http://localhost:4001"

# ── Storage & Binaries ────────────────────
DATA_DIR="./data"
FFMPEG_BIN_PATH="ffmpeg"
FFPROBE_BIN_PATH="ffprobe"
YTDLP_BIN_PATH="yt-dlp"
PYTHON_BIN_PATH="python"
WHISPER_BIN_PATH=""
WHISPER_MODEL_PATH="./models/ggml-base.en.bin"
HDD_RETENTION_DAYS=30
REQUIRE_API_KEY="false"

# ── Optional: LLM for Highlights (Gemini/OpenAI/Mock) ────
LLM_PROVIDER="mock"   # "gemini" | "openai" | "mock"
LLM_API_KEY=""
GEMINI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"

# ── Optional: Notifications ────────────────
DISCORD_WEBHOOK_GENERAL=""
DISCORD_WEBHOOK_ALERTS=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
NOTIFY_ATTACH_VIDEO_PREVIEW="true"

# ── Admin Dashboard & Stripe Billing ──────
ADMIN_PASSWORD="admin123"
STRIPE_SECRET_KEY=""              # e.g. sk_test_... or sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="" # e.g. pk_test_...
STRIPE_WEBHOOK_SECRET=""          # e.g. whsec_...
STRIPE_ALLOW_UNSIGNED_WEBHOOKS="false"
STRIPE_PRO_PAYMENT_LINK=""
STRIPE_ULTRA_PAYMENT_LINK=""
STRIPE_PRO_PRICE_ID="pro"
STRIPE_ULTRA_PRICE_ID="ultra"
STRIPE_PORTAL_URL=""

# ── Optional: Kinetic Word-Level Auto-Captions (STT) ───────
GROQ_API_KEY=""
OPENAI_API_KEY=""

# ── Next.js Web Dashboard ─────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Clipper Studio"

# ── Firebase Web SDK (Client) ─────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── Firebase Admin SDK (Server) ───────────
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ── Auth Session & Cryptographic Secrets ──
OTP_HMAC_SECRET=""
ADMIN_TOTP_ENCRYPTION_KEY=""
INTERNAL_BRIDGE_SECRET=""
SESSION_COOKIE_NAME="clipper_fb_session"
SUPERADMIN_BOOTSTRAP_EMAIL=""
DEV_OTP_ECHO="false"

# ── Resend Email OTP Delivery ─────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Clipper Studio <onboarding@resend.dev>"

# ── Upstash Redis Ratelimit (Optional) ────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Optional Sentry Error Reporting ───────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
