# ==========================================
# CLIPPER STUDIO — ENVIRONMENT CONFIGURATION
# Local-first: no cloud storage, no OAuth required for clipping.
# ==========================================

# ── Server & Ports ────────────────────────
CLIPPER_PORT=4001
NOTIFICATION_PORT=4003
HOST="127.0.0.1"
NOTIFICATION_SERVICE_URL="http://localhost:4003"
CLIPPER_SERVICE_URL="http://localhost:4001"

# ── Storage (Auto-detected: single-disk or secondary-disk) ──
# Optional override: leave commented to auto-detect based on available disks.
# If you have 2 disks, it automatically picks the secondary (e.g. D:/ClipperMedia).
# If you have 1 disk (e.g. C: only), it automatically creates C:/ClipperMedia.
# MEDIA_ROOT_DIR="D:/ClipperMedia"
DATA_DIR="./data"

# ── System Binaries (Must be on system PATH or specified here) ──
FFMPEG_BIN_PATH="ffmpeg"
FFPROBE_BIN_PATH="ffprobe"
YTDLP_BIN_PATH="yt-dlp"
PYTHON_BIN_PATH="python"

# ── Retention & Security ──────────────────
# Days before archiving raw inbox files (default 30)
HDD_RETENTION_DAYS=30
# Require csk_* bearer API keys for external non-browser calls when "true"
REQUIRE_API_KEY="false"

# ── Optional: LLM for Long-form highlight picking & Social Metadata ──
# Not needed for live chat explosion clipping. Set to "gemini" or "openai" with your own key.
LLM_PROVIDER="mock"   # "gemini" | "openai" | "mock"
LLM_API_KEY=""
GEMINI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"

# ── Optional: Notifications ────────────────
DISCORD_WEBHOOK_GENERAL=""
DISCORD_WEBHOOK_ALERTS=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
NOTIFY_ATTACH_VIDEO_PREVIEW="true"

# ── Admin Dashboard & Kelviq Merchant of Record Billing ────
# Change ADMIN_PASSWORD immediately before exposing or sharing your instance!
ADMIN_PASSWORD="admin123"
KELVIQ_API_KEY=""
KELVIQ_ENV="production"          # "production" | "sandbox"
KELVIQ_WEBHOOK_SECRET=""         # e.g. kq_whsec_...
KELVIQ_ALLOW_UNSIGNED_WEBHOOKS="false"
KELVIQ_PRO_PAYMENT_LINK=""
KELVIQ_ULTRA_PAYMENT_LINK=""
KELVIQ_PRO_PLAN_ID="pro"
KELVIQ_ULTRA_PLAN_ID="ultra"
KELVIQ_PORTAL_URL=""

# ── Optional: Kinetic Word-Level Auto-Captions (STT) ───────
# Provide GROQ_API_KEY (whisper-large-v3-turbo), OPENAI_API_KEY (whisper-1), or local whisper.cpp
GROQ_API_KEY=""
OPENAI_API_KEY=""
WHISPER_BIN_PATH=""
WHISPER_MODEL_PATH="./models/ggml-base.en.bin"
