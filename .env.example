# ==========================================
# CLIPPER STUDIO — ENVIRONMENT CONFIGURATION
# Local-first: no cloud storage, no OAuth required for clipping.
# ==========================================

# ── Server & Ports ────────────────────────
CLIPPER_PORT=4001
NOTIFICATION_PORT=4003
HOST="127.0.0.1"
NOTIFICATION_SERVICE_URL="http://localhost:4003"
CLIPPER_SERVICE_URL="http://localhost:4001"

# ── Storage (Auto-detected: single-disk or secondary-disk) ──
# Optional override: leave commented to auto-detect based on available disks.
# If you have 2 disks, it automatically picks the secondary (e.g. D:/ClipperMedia).
# If you have 1 disk (e.g. C: only), it automatically creates C:/ClipperMedia.
# MEDIA_ROOT_DIR="D:/ClipperMedia"
DATA_DIR="./data"

# ── System Binaries (Must be on system PATH or specified here) ──
FFMPEG_BIN_PATH="ffmpeg"
FFPROBE_BIN_PATH="ffprobe"
YTDLP_BIN_PATH="yt-dlp"
PYTHON_BIN_PATH="python"

# ── Retention & Security ──────────────────
# Days before archiving raw inbox files (default 30)
HDD_RETENTION_DAYS=30
# Require csk_* bearer API keys for external non-browser calls when "true"
REQUIRE_API_KEY="false"

# ── Optional: LLM for Long-form highlight picking & Social Metadata ──
# Not needed for live chat explosion clipping. Set to "gemini" or "openai" with your own key.
LLM_PROVIDER="mock"   # "gemini" | "openai" | "mock"
LLM_API_KEY=""
GEMINI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"

# ── Optional: Notifications ────────────────
DISCORD_WEBHOOK_GENERAL=""
DISCORD_WEBHOOK_ALERTS=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
NOTIFY_ATTACH_VIDEO_PREVIEW="true"

# ── Admin Dashboard & Stripe Billing ──────────────────────
# Change ADMIN_PASSWORD immediately before exposing or sharing your instance!
ADMIN_PASSWORD="admin123"
STRIPE_SECRET_KEY=""              # e.g. sk_test_... or sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="" # e.g. pk_test_...
STRIPE_WEBHOOK_SECRET=""          # e.g. whsec_...
STRIPE_ALLOW_UNSIGNED_WEBHOOKS="false"
STRIPE_PRO_PAYMENT_LINK=""
STRIPE_ULTRA_PAYMENT_LINK=""
STRIPE_PRO_PRICE_ID="pro"         # Optional Stripe price_... ID
STRIPE_ULTRA_PRICE_ID="ultra"     # Optional Stripe price_... ID
STRIPE_PORTAL_URL=""              # Optional Stripe Customer Portal URL

# ── Optional: Kinetic Word-Level Auto-Captions (STT) ───────
# Provide GROQ_API_KEY (whisper-large-v3-turbo), OPENAI_API_KEY (whisper-1), or local whisper.cpp
GROQ_API_KEY=""
OPENAI_API_KEY=""
WHISPER_BIN_PATH=""
WHISPER_MODEL_PATH="./models/ggml-base.en.bin"

# ── Next.js Web Dashboard, Firebase Auth, Resend OTP & Upstash ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Clipper Studio"

# Firebase Web SDK (public client keys from Firebase Console -> Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin SDK (server-only service account credentials)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Auth Session & OTP Signing (set random 32+ char secrets in .env.local)
OTP_HMAC_SECRET=""
ADMIN_TOTP_ENCRYPTION_KEY=""
INTERNAL_BRIDGE_SECRET=""
SESSION_COOKIE_NAME="clipper_fb_session"
SUPERADMIN_BOOTSTRAP_EMAIL=""
DEV_OTP_ECHO="false"

# Resend Email OTP Delivery
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Clipper Studio <onboarding@resend.dev>"

# Upstash Redis Ratelimit (optional — falls back to in-memory limiter in local dev)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional Sentry Error Reporting
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
